@model SistReservasDeportivas.Models.Usuario

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4">
    <div class="card bg-dark text-white border-danger shadow">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="fw-bold mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Eliminación de Usuario
            </h4>
        </div>
        <div class="card-body p-4">
            <p class="fs-5 mb-4">¿Estás seguro de que deseas eliminar la cuenta de <strong class="text-info">@Model.Nombre @Model.Apellido</strong>? Esta acción no se puede deshacer.</p>

            <dl class="row fs-5">
                <dt class="col-sm-3 text-info">Email:</dt>
                <dd class="col-sm-9">@Model.Email</dd>

                <dt class="col-sm-3 text-info">Rol:</dt>
                <dd class="col-sm-9">@Model.Rol</dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdUsuario" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger fw-bold">
                        <i class="bi bi-trash me-1"></i> Confirmar Eliminación
                    </button>
                    <a asp-action="Index" class="btn btn-outline-light">
                        <i class="bi bi-arrow-left me-1"></i> Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>