@model SistReservasDeportivas.Models.Usuario

@{
    ViewData["Title"] = "Nuevo Usuario";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4">
    <h2 class="text-white mb-4 fw-bold">
        <i class="bi bi-person-plus-fill text-info me-2"></i>Nuevo Usuario
    </h2>

    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-4">
            <form asp-action="Create" enctype="multipart/form-data" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger text-white border-0 mb-4"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label text-info fw-semibold">Nombre *</label>
                        <input asp-for="Nombre" class="form-control bg-secondary text-white border-0" required />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Apellido" class="form-label text-info fw-semibold">Apellido *</label>
                        <input asp-for="Apellido" class="form-control bg-secondary text-white border-0" required />
                        <span asp-validation-for="Apellido" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Email" class="form-label text-info fw-semibold">Email *</label>
                        <input asp-for="Email" type="email" class="form-control bg-secondary text-white border-0" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Clave" class="form-label text-info fw-semibold">Contraseña *</label>
                        <input asp-for="Clave" type="password" class="form-control bg-secondary text-white border-0" required />
                        <span asp-validation-for="Clave" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Rol" class="form-label text-info fw-semibold">Rol *</label>
                        <select asp-for="Rol" class="form-select bg-secondary text-white border-0" required>
                            <option value="Empleado">Empleado</option>
                            <option value="Administrador">Administrador</option>
                        </select>
                        <span asp-validation-for="Rol" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label text-info fw-semibold">Avatar de Perfil (Opcional)</label>
                        <input type="file" name="AvatarFile" class="form-control bg-secondary text-white border-0" accept="image/*" />
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success fw-bold">
                        <i class="bi bi-check-circle me-1"></i> Guardar Usuario
                    </button>
                    <a asp-action="Index" class="btn btn-outline-light">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}