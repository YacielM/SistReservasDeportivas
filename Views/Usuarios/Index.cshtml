@model IEnumerable<SistReservasDeportivas.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-0">
                <i class="bi bi-shield-lock text-info me-2"></i>Gestión de Usuarios
            </h2>
            <p class="text-muted small mb-0">Administra los usuarios del sistema y sus roles de acceso.</p>
        </div>
        <a asp-action="Create" class="btn btn-success fw-bold">
            <i class="bi bi-person-plus-fill me-1"></i> Nuevo Usuario
        </a>
    </div>

    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="border-bottom border-secondary text-info">
                        <tr>
                            <th class="ps-3" style="width: 70px;">Avatar</th>
                            <th>Nombre Completo</th>
                            <th>Email</th>
                            <th class="text-center">Rol</th>
                            <th class="text-center pe-3" style="width: 150px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">No hay usuarios registrados.</td>
                            </tr>
                        }
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="ps-3">
                                    @if (!string.IsNullOrEmpty(user.Avatar))
                                    {
                                        <img src="~/avatars/@user.Avatar" class="rounded-circle border border-secondary" width="40" height="40" style="object-fit: cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px;">
                                            @user.Nombre.Substring(0, 1).ToUpper()
                                        </div>
                                    }
                                </td>
                                <td><strong>@user.Nombre @user.Apellido</strong></td>
                                <td>@user.Email</td>
                                <td class="text-center">
                                    @if (user.Rol == "Administrador")
                                    {
                                        <span class="badge bg-danger shadow-sm"><i class="bi bi-shield-fill-check me-1"></i>Administrador</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-white shadow-sm"><i class="bi bi-person-badge me-1"></i>Empleado</span>
                                    }
                                </td>
                                <td class="text-center pe-3">
                                    <div class="btn-group btn-group-sm">
                                        <a asp-action="Details" asp-route-id="@user.IdUsuario" class="btn btn-info text-white" title="Ver Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@user.IdUsuario" class="btn btn-warning" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@user.IdUsuario" class="btn btn-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>