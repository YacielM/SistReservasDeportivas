@model SistReservasDeportivas.Models.Usuario

@{
    ViewData["Title"] = "Detalles de Usuario";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4">
    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-header bg-dark border-secondary py-3">
            <h4 class="fw-bold text-info mb-0">
                <i class="bi bi-person-bounding-box me-2"></i>Perfil de Usuario
            </h4>
        </div>
        <div class="card-body p-4">
            <div class="row align-items-center g-4">
                <div class="col-md-3 text-center">
                    @if (!string.IsNullOrEmpty(Model.Avatar))
                    {
                        <img src="~/avatars/@Model.Avatar" class="rounded-circle border border-info shadow" width="120" height="120" style="object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-1 mx-auto shadow" style="width: 120px; height: 120px;">
                            @Model.Nombre.Substring(0, 1).ToUpper()
                        </div>
                    }
                </div>
                <div class="col-md-9">
                    <dl class="row fs-5 mb-0">
                        <dt class="col-sm-4 text-info fw-semibold">Nombre Completo:</dt>
                        <dd class="col-sm-8">@Model.Nombre @Model.Apellido</dd>

                        <dt class="col-sm-4 text-info fw-semibold">Correo Electrónico:</dt>
                        <dd class="col-sm-8">@Model.Email</dd>

                        <dt class="col-sm-4 text-info fw-semibold">Rol Asignado:</dt>
                        <dd class="col-sm-8">
                            @if (Model.Rol == "Administrador")
                            {
                                <span class="badge bg-danger"><i class="bi bi-shield-fill-check me-1"></i>Administrador</span>
                            }
                            else
                            {
                                <span class="badge bg-info text-white"><i class="bi bi-person-badge me-1"></i>Empleado</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer bg-dark border-secondary d-flex gap-2 py-3">
            <a asp-action="Edit" asp-route-id="@Model.IdUsuario" asp-route-returnUrl="@Context.Request.Path@Context.Request.QueryString" class="btn btn-warning fw-bold">
                <i class="bi bi-pencil-square me-1"></i> Editar
            </a>
            <a asp-action="Index" class="btn btn-outline-light">
                <i class="bi bi-arrow-left me-1"></i> Volver a Usuarios
            </a>
        </div>
    </div>
</div>