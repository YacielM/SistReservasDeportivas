@{
    Layout = null;
    ViewData["Title"] = "Iniciar Sesión";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistReservasDeportivas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background-color: #121212;
            color: #e0e0e0;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <div class="container" style="max-width: 420px;">
        <div class="card bg-dark text-white border-secondary shadow-lg">
            <div class="card-body p-4 text-center">
                <div class="p-3 bg-info bg-opacity-10 text-info rounded-circle d-inline-block mb-3">
                    <i class="bi bi-trophy-fill fs-1"></i>
                </div>
                <h3 class="fw-bold text-white mb-1">SistReservas</h3>
                <p class="text-muted small mb-4">Ingresa tus credenciales para acceder al sistema</p>

                @if (ViewData["Error"] != null)
                {
                    <div class="alert alert-danger bg-danger text-white border-0 py-2 small mb-3">
                        @ViewData["Error"]
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <div class="text-start mb-3">
                        <label class="form-label text-info fw-semibold small">Correo Electrónico</label>
                        <div class="input-group">
                            <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-envelope"></i></span>
                            <input type="email" name="email" class="form-control bg-secondary text-white border-0" placeholder="admin@sist.com" required />
                        </div>
                    </div>

                    <div class="text-start mb-4">
                        <label class="form-label text-info fw-semibold small">Contraseña</label>
                        <div class="input-group">
                            <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-lock"></i></span>
                            <input type="password" name="clave" class="form-control bg-secondary text-white border-0" placeholder="••••••••" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-info text-white fw-bold w-100 py-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                    </button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>