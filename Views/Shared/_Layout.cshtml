<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistReservasDeportivas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background-color: #121212;
            color: #e0e0e0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        main {
            flex: 1;
        }
        .navbar-custom {
            background-color: #1a1d20 !important;
            border-bottom: 1px solid #2d3238;
        }
        .footer-custom {
            background-color: #1a1d20;
            border-top: 1px solid #2d3238;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark navbar-custom shadow-sm mb-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand fw-bold text-info" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-trophy-fill me-2"></i>SistReservasDeportivas
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    @{
                        bool estaAutenticado = User.Identity?.IsAuthenticated == true || Context.Session.GetString("UsuarioEmail") != null;
                        string? usuarioEmail = Context.Session.GetString("UsuarioEmail") ?? User.Identity?.Name ?? "Usuario";
                        string? usuarioRol = Context.Session.GetString("UsuarioRol") ?? (User.IsInRole("Administrador") ? "Administrador" : "Empleado");
                    }

                    <ul class="navbar-nav flex-grow-1 ms-3 gap-1">
                        @if (estaAutenticado)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index"><i class="bi bi-house-door me-1"></i>Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Clientes" asp-action="Index"><i class="bi bi-people me-1"></i>Clientes</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Canchas" asp-action="Index"><i class="bi bi-geo-alt me-1"></i>Canchas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Reservas" asp-action="Index"><i class="bi bi-calendar-check me-1"></i>Reservas</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-white" asp-area="" asp-controller="Pagos" asp-action="Index"><i class="bi bi-wallet2 me-1"></i>Pagos</a>
                            </li>
                            @if (usuarioRol == "Administrador" || User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-white" asp-area="" asp-controller="Usuarios" asp-action="Index"><i class="bi bi-shield-lock me-1"></i>Usuarios</a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center gap-2">
                        @if (estaAutenticado)
                        {
                            <li class="nav-item">
                                <span class="badge bg-secondary text-white fw-normal py-2 px-3">
                                    <i class="bi bi-person-circle me-1 text-info"></i>@usuarioEmail (@usuarioRol)
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-outline-danger" asp-controller="Usuarios" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right me-1"></i>Cerrar Sesión
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-info text-white fw-bold" asp-controller="Usuarios" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i>Iniciar Sesión
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="footer-custom text-muted py-3 mt-auto">
        <div class="container text-center small">
            &copy; @DateTime.Now.Year - SistReservasDeportivas — <a asp-area="" asp-controller="Home" asp-action="Privacy" class="text-info text-decoration-none">Privacidad</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>