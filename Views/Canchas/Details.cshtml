@model SistReservasDeportivas.Models.Cancha

@{
    ViewData["Title"] = "Detalles de Cancha";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4">
    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center py-3">
            <h4 class="fw-bold text-info mb-0">
                <i class="bi bi-info-circle me-2"></i>@Model.Nombre
            </h4>
            <div>
                @if (Model.Estado == "Disponible")
                {
                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Disponible</span>
                }
                else if (Model.Estado == "Mantenimiento")
                {
                    <span class="badge bg-warning text-dark"><i class="bi bi-tools me-1"></i>Mantenimiento</span>
                }
                else
                {
                    <span class="badge bg-secondary">@Model.Estado</span>
                }
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-4">
                <!-- Foto o Placeholder Oscuro -->
                <div class="col-md-5">
                    <div style="height: 250px;" class="bg-secondary bg-opacity-25 d-flex align-items-center justify-content-center rounded overflow-hidden border border-secondary">
                        @if (!string.IsNullOrEmpty(Model.Foto))
                        {
                            <img src="~/canchas/@Model.Foto" class="w-100 h-100" style="object-fit: cover;" alt="@Model.Nombre" />
                        }
                        else
                        {
                            <div class="text-center text-muted">
                                <i class="bi bi-image fs-1 d-block mb-1"></i>
                                <span class="small fw-semibold">Sin imagen disponible</span>
                            </div>
                        }
                    </div>
                </div>

                <!-- Datos de la Cancha -->
                <div class="col-md-7 d-flex flex-column justify-content-center">
                    <dl class="row mb-0 fs-5">
                        <dt class="col-sm-4 text-info fw-semibold">Tipo / Deporte:</dt>
                        <dd class="col-sm-8">@Model.Tipo</dd>

                        <dt class="col-sm-4 text-info fw-semibold">Precio por Hora:</dt>
                        <dd class="col-sm-8 text-success fw-bold">@Model.PrecioHora.ToString("C")</dd>

                        <dt class="col-sm-4 text-info fw-semibold">Estado Actual:</dt>
                        <dd class="col-sm-8">@Model.Estado</dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="card-footer bg-dark border-secondary d-flex gap-2 py-3">
            @if (User.IsInRole("Administrador"))
            {
                <a asp-action="Edit" asp-route-id="@Model.IdCancha" class="btn btn-warning">
                    <i class="bi bi-pencil-square me-1"></i> Editar
                </a>
            }
            <a asp-action="Index" class="btn btn-outline-light">
                <i class="bi bi-arrow-left me-1"></i> Volver a Canchas
            </a>
        </div>
    </div>
</div>