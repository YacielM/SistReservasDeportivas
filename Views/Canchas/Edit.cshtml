@model SistReservasDeportivas.Models.Cancha

@{
    ViewData["Title"] = "Editar Cancha";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4">
    <h2 class="text-white mb-4 fw-bold">
        <i class="bi bi-pencil-square text-warning me-2"></i>Editar Cancha
    </h2>

    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-4">
            <form asp-action="Edit" enctype="multipart/form-data" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdCancha" />
                <input type="hidden" asp-for="Foto" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger text-white border-0 mb-4"></div>

                <div class="row g-3">
                    <!-- Nombre -->
                    <div class="col-md-6">
                        <label asp-for="Nombre" class="form-label text-info fw-semibold">Nombre de la Cancha *</label>
                        <input asp-for="Nombre" class="form-control bg-secondary text-white border-0" required />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <!-- Tipo -->
                    <div class="col-md-6">
                        <label asp-for="Tipo" class="form-label text-info fw-semibold">Tipo / Deporte *</label>
                        <select asp-for="Tipo" class="form-select bg-secondary text-white border-0" required>
                            <option value="Fútbol 5">Fútbol 5</option>
                            <option value="Fútbol 7">Fútbol 7</option>
                            <option value="Fútbol 11">Fútbol 11</option>
                            <option value="Pádel">Pádel</option>
                            <option value="Tenis">Tenis</option>
                            <option value="Básquet">Básquet</option>
                        </select>
                        <span asp-validation-for="Tipo" class="text-danger small"></span>
                    </div>

                    <!-- Precio por Hora -->
                    <div class="col-md-6">
                        <label asp-for="PrecioHora" class="form-label text-info fw-semibold">Precio por Hora ($) *</label>
                        <input asp-for="PrecioHora" type="text" class="form-control bg-secondary text-white border-0" required />
                        <span asp-validation-for="PrecioHora" class="text-danger small"></span>
                    </div>

                    <!-- Estado -->
                    <div class="col-md-6">
                        <label asp-for="Estado" class="form-label text-info fw-semibold">Estado *</label>
                        <select asp-for="Estado" class="form-select bg-secondary text-white border-0" required>
                            <option value="Disponible">Disponible</option>
                            <option value="Mantenimiento">Mantenimiento</option>
                            <option value="Inactiva">Inactiva</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>

                    <!-- Previsualización de Foto y Subida de Nueva -->
                    <div class="col-md-12">
                        <label class="form-label text-info fw-semibold">Imagen Actual / Reemplazar</label>
                        <div class="d-flex align-items-center gap-3 mb-2">
                            @if (!string.IsNullOrEmpty(Model.Foto))
                            {
                                <img src="~/canchas/@Model.Foto" width="100" height="70" style="object-fit: cover;" class="rounded border border-secondary" />
                            }
                            else
                            {
                                <div class="bg-secondary bg-opacity-25 p-3 rounded text-muted small text-center" style="width: 100px;">
                                    Sin foto
                                </div>
                            }
                            <input type="file" name="FotoArchivo" class="form-control bg-secondary text-white border-0" accept="image/*" />
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-warning fw-bold">
                        <i class="bi bi-save me-1"></i> Guardar Cambios
                    </button>
                    <a asp-action="Index" class="btn btn-outline-light">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Permitir la entrada de decimales con comas en jQuery Validation
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s,.]\d{3})+)(?:[\s,.]\d+)?$/.test(value);
        };
    </script>
}