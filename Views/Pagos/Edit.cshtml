@model SistReservasDeportivas.Models.Pago

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4" style="max-width: 700px;">
    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-header border-secondary bg-dark d-flex align-items-center">
            <i class="bi bi-pencil-square text-warning fs-4 me-2"></i>
            <h4 class="mb-0">Actualizar Estado de Pago</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdPago" />
                <input type="hidden" asp-for="CreadoPor" />

                <div asp-validation-summary="All" class="alert alert-danger mb-3" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="IdReserva" class="form-label text-muted">Reserva Asociada</label>
                        <select asp-for="IdReserva" class="form-select bg-secondary text-white border-0" asp-items="@(ViewData["IdReserva"] as SelectList)">
                        </select>
                        <span asp-validation-for="IdReserva" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="EstadoPago" class="form-label fw-bold">Estado del Pago</label>
                        <select asp-for="EstadoPago" class="form-select bg-secondary text-white border-0">
                            <option value="Pendiente">Pendiente</option>
                            <option value="Pagado">Pagado</option>
                            <option value="Anulado">Anulado</option>
                        </select>
                        <span asp-validation-for="EstadoPago" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="MetodoPago" class="form-label fw-bold">Método de Pago</label>
                        <select asp-for="MetodoPago" class="form-select bg-secondary text-white border-0">
                            <option value="">-- Seleccionar --</option>
                            <option value="Efectivo">Efectivo</option>
                            <option value="Mercado Pago">Mercado Pago</option>
                            <option value="Transferencia">Transferencia</option>
                            <option value="Tarjeta">Tarjeta de Débito / Crédito</option>
                        </select>
                        <span asp-validation-for="MetodoPago" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Importe" class="form-label fw-bold">Importe ($)</label>
                        <input asp-for="Importe" 
                               type="number" 
                               step="0.01" 
                               value="@Model.Importe.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" 
                               class="form-control bg-secondary text-white border-0" />
                        <span asp-validation-for="Importe" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Fecha" class="form-label">Fecha de Registro</label>
                        <input asp-for="Fecha" type="date" class="form-control bg-secondary text-white border-0" />
                        <span asp-validation-for="Fecha" class="text-danger"></span>
                    </div>
                </div>

                <div class="mt-4 d-flex justify-content-end gap-2 border-top border-secondary pt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary text-white">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                    <button type="submit" class="btn btn-warning text-dark fw-bold">
                        <i class="bi bi-save me-1"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        // Permitir la validación de decimales con punto o coma en el cliente
        if ($.validator) {
            $.validator.methods.number = function (value, element) {
                return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s,.]\d{3})+)(?:[\.,]\d+)?$/.test(value);
            };
        }
    </script>
}