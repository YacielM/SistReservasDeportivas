@model IEnumerable<SistReservasDeportivas.Models.Reserva>

@{
    ViewData["Title"] = "Panel Principal";
    int reservasHoy = (ViewData["ReservasHoy"] as int?) ?? 0;
    decimal recaudacionMes = (ViewData["RecaudacionMes"] as decimal?) ?? 0;
    int totalDeudores = (ViewData["TotalDeudores"] as int?) ?? 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4">
    <!-- Encabezado de Bienvenida -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-0">
                <i class="bi bi-speedometer2 text-info me-2"></i>Panel de Control
            </h2>
            <p class="text-muted mb-0 small">Bienvenido al sistema de gestión de reservas deportivas.</p>
        </div>
        <div>
            <span class="badge bg-dark border border-secondary text-info px-3 py-2 fw-semibold">
                <i class="bi bi-calendar-event me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
            </span>
        </div>
    </div>

    <!-- Tarjetas KPI / Métricas -->
    <div class="row g-3 mb-4">
        <!-- Tarjeta 1: Reservas de Hoy -->
        <div class="col-md-4">
            <div class="card bg-dark text-white border-secondary shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">Reservas de Hoy</span>
                        <h3 class="fw-bold mb-0 text-info">@reservasHoy</h3>
                    </div>
                    <div class="p-3 bg-info bg-opacity-10 text-info rounded-3">
                        <i class="bi bi-calendar-check fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta 2: Recaudación del Mes -->
        <div class="col-md-4">
            <div class="card bg-dark text-white border-secondary shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">Recaudación (Mes)</span>
                        <h3 class="fw-bold mb-0 text-success">@recaudacionMes.ToString("C")</h3>
                    </div>
                    <div class="p-3 bg-success bg-opacity-10 text-success rounded-3">
                        <i class="bi bi-cash-stack fs-2"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tarjeta 3: Clientes Morosos -->
        <div class="col-md-4">
            <div class="card bg-dark text-white border-secondary shadow-sm h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <span class="text-muted small fw-semibold text-uppercase d-block">Clientes con Deuda</span>
                        <h3 class="fw-bold mb-0 @(totalDeudores > 0 ? "text-danger" : "text-light")">@totalDeudores</h3>
                    </div>
                    <div class="p-3 @(totalDeudores > 0 ? "bg-danger bg-opacity-10 text-danger" : "bg-secondary bg-opacity-10 text-muted") rounded-3">
                        <i class="bi bi-exclamation-triangle fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Sección de Accesos Rápidos -->
    <div class="card bg-dark text-white border-secondary shadow-sm mb-4">
        <div class="card-body p-3">
            <h6 class="text-info fw-bold mb-3"><i class="bi bi-lightning-charge me-1"></i>Acciones Rápidas</h6>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Reservas" asp-action="Create" class="btn btn-info text-white fw-semibold">
                    <i class="bi bi-plus-circle me-1"></i> Nueva Reserva
                </a>
                <a asp-controller="Pagos" asp-action="Index" class="btn btn-outline-success fw-semibold">
                    <i class="bi bi-wallet2 me-1"></i> Registrar / Ver Pagos
                </a>
                <a asp-controller="Clientes" asp-action="Index" class="btn btn-outline-light fw-semibold">
                    <i class="bi bi-people me-1"></i> Gestión de Clientes
                </a>
                <a asp-controller="Canchas" asp-action="Index" class="btn btn-outline-light fw-semibold">
                    <i class="bi bi-trophy me-1"></i> Ver Canchas
                </a>
            </div>
        </div>
    </div>

    <!-- Próximos Turnos Programados -->
    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-header bg-dark border-secondary d-flex justify-content-between align-items-center py-3">
            <h5 class="fw-bold text-white mb-0">
                <i class="bi bi-clock-history text-info me-2"></i>Próximos Turnos
            </h5>
            <a asp-controller="Reservas" asp-action="Index" class="btn btn-sm btn-outline-info">
                Ver todas <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="border-bottom border-secondary text-info">
                        <tr>
                            <th class="text-center">#</th>
                            <th>Cliente</th>
                            <th>Cancha</th>
                            <th class="text-center">Fecha</th>
                            <th class="text-center">Horario</th>
                            <th class="text-end pe-4">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">No hay turnos próximos programados.</td>
                            </tr>
                        }
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td class="text-center fw-bold">#@r.IdReserva</td>
                                <td><strong>@r.Cliente?.Nombre @r.Cliente?.Apellido</strong></td>
                                <td>@r.Cancha?.Nombre <span class="text-muted">(@r.Cancha?.Tipo)</span></td>
                                <td class="text-center">@r.Fecha.ToShortDateString()</td>
                                <td class="text-center">
                                    <span class="badge bg-dark border border-secondary">
                                        @r.HoraInicio.ToString(@"hh\:mm") - @r.HoraFin.ToString(@"hh\:mm")
                                    </span>
                                </td>
                                <td class="text-end pe-4 fw-semibold text-light">@r.Monto.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>