@model IEnumerable<SistReservasDeportivas.Models.Reserva>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold mb-0">
            <i class="bi bi-calendar-check text-info me-2"></i>Reservas
        </h2>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-circle me-1"></i> Nueva Reserva
        </a>
    </div>

    <!-- Barra de Filtros y Ordenamiento -->
    <div class="card bg-dark text-white border-secondary shadow-sm mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <!-- Buscador -->
                <div class="col-md-4">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control bg-secondary text-white border-0" placeholder="Buscar por cliente o cancha...">
                    </div>
                </div>

                <!-- Filtro de Estado -->
                <div class="col-md-3">
                    <select name="estado" class="form-select form-select-sm bg-secondary text-white border-0">
                        <option value="">-- Todos los Estados --</option>
                        <option value="activas" selected="@((string)ViewData["CurrentEstado"] == "activas")">Sólo Activas</option>
                        <option value="canceladas" selected="@((string)ViewData["CurrentEstado"] == "canceladas")">Sólo Canceladas</option>
                    </select>
                </div>

                <!-- Ordenamiento -->
                <div class="col-md-3">
                    <select name="sortOrder" class="form-select form-select-sm bg-secondary text-white border-0">
                        <option value="fecha_desc" selected="@((string)ViewData["CurrentSort"] == "fecha_desc" || string.IsNullOrEmpty((string)ViewData["CurrentSort"]))">Fecha (Más recientes primero)</option>
                        <option value="fecha_asc" selected="@((string)ViewData["CurrentSort"] == "fecha_asc")">Fecha (Más antiguas primero)</option>
                        <option value="monto_desc" selected="@((string)ViewData["CurrentSort"] == "monto_desc")">Monto (Mayor a Menor)</option>
                        <option value="monto_asc" selected="@((string)ViewData["CurrentSort"] == "monto_asc")">Monto (Menor a Mayor)</option>
                        <option value="cliente" selected="@((string)ViewData["CurrentSort"] == "cliente")">Cliente (A-Z)</option>
                    </select>
                </div>

                <!-- Botones -->
                <div class="col-md-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-info text-white w-100">
                        <i class="bi bi-funnel me-1"></i>Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary text-white" title="Limpiar filtros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla -->
    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="border-bottom border-secondary text-info">
                        <tr>
                            <th>Cliente</th>
                            <th>Cancha</th>
                            <th>Fecha</th>
                            <th>Hora Inicio</th>
                            <th>Hora Fin</th>
                            <th class="text-end">Monto</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center" style="width: 200px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No se encontraron reservas con los criterios ingresados.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.Cancelada ? "opacity-50" : "")">
                            <td>
                                <strong>@item.Cliente?.Nombre @item.Cliente?.Apellido</strong>
                            </td>
                            <td>@item.Cancha?.Nombre <span class="text-muted">(@item.Cancha?.Tipo)</span></td>
                            <td>@item.Fecha.ToShortDateString()</td>
                            <td>@item.HoraInicio</td>
                            <td>@item.HoraFin</td>
                            <td class="text-end fw-semibold">@item.Monto.ToString("C")</td>
                            <td class="text-center">
                                @if (item.Cancelada)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Cancelada</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Activa</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-info text-white" title="Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (!item.Cancelada)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-warning" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <form asp-action="Cancelar" asp-route-id="@item.IdReserva" method="post" class="d-inline" onsubmit="return confirm('¿Confirmas la cancelación de esta reserva?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-warning" title="Cancelar Reserva">
                                                <i class="bi bi-slash-circle"></i>
                                            </button>
                                        </form>
                                    }
                                    <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Paginación con persistencia de filtros -->
    <div class="d-flex justify-content-center mt-4">
        <nav>
            <ul class="pagination pagination-sm">
                @{
                    int totalPages = (ViewData["TotalPages"] as int?) ?? 0;
                    int currentPage = (ViewData["CurrentPage"] as int?) ?? 1;
                    string currentSearch = (string)ViewData["CurrentSearch"];
                    string currentEstado = (string)ViewData["CurrentEstado"];
                    string currentSort = (string)ViewData["CurrentSort"];
                }

                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link bg-dark text-white border-secondary" 
                       asp-action="Index" 
                       asp-route-page="@(currentPage - 1)"
                       asp-route-search="@currentSearch"
                       asp-route-estado="@currentEstado"
                       asp-route-sortOrder="@currentSort">Anterior</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link @(i == currentPage ? "bg-info border-info text-white fw-bold" : "bg-dark text-white border-secondary")" 
                           asp-action="Index" 
                           asp-route-page="@i"
                           asp-route-search="@currentSearch"
                           asp-route-estado="@currentEstado"
                           asp-route-sortOrder="@currentSort">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages || totalPages == 0 ? "disabled" : "")">
                    <a class="page-link bg-dark text-white border-secondary" 
                       asp-action="Index" 
                       asp-route-page="@(currentPage + 1)"
                       asp-route-search="@currentSearch"
                       asp-route-estado="@currentEstado"
                       asp-route-sortOrder="@currentSort">Siguiente</a>
                </li>
            </ul>
        </nav>
    </div>
</div>