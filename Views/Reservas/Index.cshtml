@model IEnumerable<SistReservasDeportivas.Models.Reserva>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold mb-0">
            <i class="bi bi-calendar-check text-info me-2"></i>Gestión de Reservas
        </h2>
        <a asp-action="Create" class="btn btn-info text-white fw-bold">
            <i class="bi bi-plus-circle me-1"></i>Nueva Reserva
        </a>
    </div>

    <!-- Filtros y Búsqueda -->
    <div class="card bg-dark text-white border-secondary shadow-sm mb-4">
        <div class="card-body p-3">
            <form asp-action="Index" method="get" class="row g-2 align-items-center">
                <!-- Buscador -->
                <div class="col-md-3">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@ViewData["CurrentSearch"]" class="form-control bg-secondary text-white border-0" placeholder="Buscar cliente o cancha...">
                    </div>
                </div>

                <!-- Filtro Estado -->
                <div class="col-md-3">
                    <select name="estado" class="form-select form-select-sm bg-secondary text-white border-0">
                        <option value="">-- Todos los Estados --</option>
                        <option value="Activa" selected="@((string)ViewData["CurrentEstado"] == "Activa")">Activa</option>
                        <option value="Finalizada" selected="@((string)ViewData["CurrentEstado"] == "Finalizada")">Finalizada</option>
                        <option value="Cancelada" selected="@((string)ViewData["CurrentEstado"] == "Cancelada")">Cancelada</option>
                    </select>
                </div>

                <!-- Orden -->
                <div class="col-md-3">
                    <select name="sortOrder" class="form-select form-select-sm bg-secondary text-white border-0">
                        <option value="fecha_desc" selected="@((string)ViewData["CurrentSort"] == "fecha_desc" || string.IsNullOrEmpty((string)ViewData["CurrentSort"]))">Fecha (Más recientes)</option>
                        <option value="fecha_asc" selected="@((string)ViewData["CurrentSort"] == "fecha_asc")">Fecha (Más antiguas)</option>
                    </select>
                </div>

                <!-- Botones -->
                <div class="col-md-3 d-flex gap-1">
                    <button type="submit" class="btn btn-sm btn-info text-white w-100">
                        <i class="bi bi-funnel"></i> Filtrar
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary text-white" title="Limpiar">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de Reservas -->
    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="border-bottom border-secondary text-info">
                        <tr>
                            <th class="text-center">#</th>
                            <th>Cliente</th>
                            <th>Cancha</th>
                            <th class="text-center">Fecha</th>
                            <th class="text-center">Horario</th>
                            <th class="text-end">Precio Total</th>
                            <th class="text-center">Estado</th>
                            <th class="text-center" style="width: 180px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">No se encontraron registros de reservas.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="text-center fw-bold">#@item.IdReserva</td>
                            <td>
                                <strong>@item.Cliente?.Nombre @item.Cliente?.Apellido</strong>
                            </td>
                            <td>@item.Cancha?.Nombre <span class="text-muted">(@item.Cancha?.Tipo)</span></td>
                            <td class="text-center">@item.Fecha.ToShortDateString()</td>
                            <td class="text-center">
                                <span class="badge bg-dark border border-secondary">
                                    @item.HoraInicio.ToString(@"hh\:mm") - @item.HoraFin.ToString(@"hh\:mm")
                                </span>
                            </td>
                            <td class="text-end fw-semibold text-light">@item.Monto.ToString("C")</td>
                            <td class="text-center">
                                @if (item.Cancelada)
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Cancelada</span>
                                }
                                else if (item.Fecha.Date.Add(item.HoraFin) < DateTime.Now)
                                {
                                    <span class="badge bg-secondary"><i class="bi bi-clock-history me-1"></i>Finalizada</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Activa</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@item.IdReserva" class="btn btn-info text-white" title="Ver Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.IdReserva" class="btn btn-warning" title="Editar Reserva">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.IdReserva" class="btn btn-danger" title="Eliminar / Cancelar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Paginación -->
    <div class="d-flex justify-content-center mt-4">
        <nav>
            <ul class="pagination pagination-sm">
                @{
                    int totalPages = (ViewData["TotalPages"] as int?) ?? 0;
                    int currentPage = (ViewData["CurrentPage"] as int?) ?? 1;
                    string search = (string)ViewData["CurrentSearch"];
                    string estado = (string)ViewData["CurrentEstado"];
                    string sort = (string)ViewData["CurrentSort"];
                }

                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link bg-dark text-white border-secondary" 
                       asp-action="Index" 
                       asp-route-page="@(currentPage - 1)"
                       asp-route-search="@search"
                       asp-route-estado="@estado"
                       asp-route-sortOrder="@sort">Anterior</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link @(i == currentPage ? "bg-info border-info text-white fw-bold" : "bg-dark text-white border-secondary")" 
                           asp-action="Index" 
                           asp-route-page="@i"
                           asp-route-search="@search"
                           asp-route-estado="@estado"
                           asp-route-sortOrder="@sort">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages || totalPages == 0 ? "disabled" : "")">
                    <a class="page-link bg-dark text-white border-secondary" 
                       asp-action="Index" 
                       asp-route-page="@(currentPage + 1)"
                       asp-route-search="@search"
                       asp-route-estado="@estado"
                       asp-route-sortOrder="@sort">Siguiente</a>
                </li>
            </ul>
        </nav>
    </div>
</div>