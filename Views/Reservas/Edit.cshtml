@model SistReservasDeportivas.Models.Reserva

@{
    ViewData["Title"] = "Editar Reserva";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4" id="appEditReserva">
    <h2 class="text-white mb-4 fw-bold">
        <i class="bi bi-pencil-square text-warning me-2"></i>Editar Reserva #@Model.IdReserva
    </h2>

    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-4">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdReserva" />
                <input type="hidden" asp-for="CreadoPor" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger bg-danger text-white border-0 mb-4"></div>

                <div class="row g-3">
                    <!-- Cliente -->
                    <div class="col-md-6">
                        <label asp-for="IdCliente" class="form-label text-info fw-semibold">Cliente *</label>
                        <select asp-for="IdCliente" class="form-select bg-secondary text-white border-0" asp-items="ViewBag.IdCliente" required></select>
                        <span asp-validation-for="IdCliente" class="text-danger small"></span>
                    </div>

                    <!-- Cancha -->
                    <div class="col-md-6">
                        <label asp-for="IdCancha" class="form-label text-info fw-semibold">Cancha *</label>
                        <select asp-for="IdCancha" id="selectCancha" class="form-select bg-secondary text-white border-0" asp-items="ViewBag.IdCancha" required></select>
                        <span asp-validation-for="IdCancha" class="text-danger small"></span>
                    </div>

                    <!-- Fecha -->
                    <div class="col-md-4">
                        <label asp-for="Fecha" class="form-label text-info fw-semibold">Fecha *</label>
                        <input asp-for="Fecha" type="date" class="form-control bg-secondary text-white border-0" required />
                        <span asp-validation-for="Fecha" class="text-danger small"></span>
                    </div>

                    <!-- Hora Inicio -->
                    <div class="col-md-4">
                        <label asp-for="HoraInicio" class="form-label text-info fw-semibold">Hora Inicio *</label>
                        <input asp-for="HoraInicio" id="horaInicio" type="time" class="form-control bg-secondary text-white border-0" required />
                        <span asp-validation-for="HoraInicio" class="text-danger small"></span>
                    </div>

                    <!-- Hora Fin -->
                    <div class="col-md-4">
                        <label asp-for="HoraFin" class="form-label text-info fw-semibold">Hora Fin *</label>
                        <input asp-for="HoraFin" id="horaFin" type="time" class="form-control bg-secondary text-white border-0" required />
                        <span asp-validation-for="HoraFin" class="text-danger small"></span>
                    </div>

                    <!-- Monto Calculado (Readonly y formateado a 2 decimales) -->
                    <div class="col-md-6">
                        <label asp-for="Monto" class="form-label text-info fw-semibold">Monto Total ($) *</label>
                        <input asp-for="Monto" id="inputMonto" type="text" value="@Model.Monto.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control bg-secondary text-white border-0 fs-5 fw-bold text-success" readonly />
                        <small class="text-muted d-block mt-1">Calculado automáticamente según la duración y el tipo de cancha.</small>
                    </div>

                    <!-- Cancelada -->
                    <div class="col-md-6 d-flex align-items-center mt-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" asp-for="Cancelada" id="flexSwitchCancelada">
                            <label class="form-check-label text-white fw-semibold" for="flexSwitchCancelada">
                                Marcar Reserva como Cancelada
                            </label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-warning fw-bold">
                        <i class="bi bi-save me-1"></i> Guardar Cambios
                    </button>
                    <a asp-action="Index" class="btn btn-outline-light">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Permitir decimales con comas en validación
        $.validator.methods.number = function (value, element) {
            return this.optional(element) || /^-?(?:\d+|\d{1,3}(?:[\s,.]\d{3})+)(?:[\s,.]\d+)?$/.test(value);
        };

        // Recalcular el monto dinámicamente si cambian el horario o la cancha
        async function RecalcularMontoEdicion() {
            const idCancha = $('#selectCancha').val();
            const hInicio = $('#horaInicio').val();
            const hFin = $('#horaFin').val();

            if (!idCancha || !hInicio || !hFin) return;

            const [hIni, mIni] = hInicio.split(':').map(Number);
            const [hF, mF] = hFin.split(':').map(Number);

            const minsInicio = hIni * 60 + mIni;
            const minsFin = hF * 60 + mF;

            if (minsFin <= minsInicio) return;

            const duracionHoras = (minsFin - minsInicio) / 60;

            try {
                // Obtener el precio/hora actual de la cancha vía API
                const res = await fetch(`/api/CanchasApi`);
                const canchas = await res.json();
                const cancha = canchas.find(c => c.idCancha == idCancha);

                if (cancha) {
                    const total = (duracionHoras * cancha.precioHora).toFixed(2);
                    $('#inputMonto').val(total);
                }
            } catch (err) {
                console.error("Error al obtener precio de cancha:", err);
            }
        }

        $('#selectCancha, #horaInicio, #horaFin').on('change', RecalcularMontoEdicion);
    </script>
}