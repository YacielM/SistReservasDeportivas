@model SistReservasDeportivas.Models.Reserva

@{
    ViewData["Title"] = "Cancelar Reserva";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container my-4">
    <div class="card bg-dark text-white border-danger shadow">
        <div class="card-header bg-danger text-white py-3">
            <h4 class="fw-bold mb-0">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Cancelación de Reserva
            </h4>
        </div>
        <div class="card-body p-4">
            <p class="fs-5 mb-4">¿Estás seguro de que deseas cancelar la reserva <strong class="text-info">#@Model.IdReserva</strong> del cliente <strong class="text-light">@Model.Cliente?.Nombre @Model.Cliente?.Apellido</strong>?</p>

            <dl class="row fs-5">
                <dt class="col-sm-3 text-info">Cancha:</dt>
                <dd class="col-sm-9">@Model.Cancha?.Nombre (@Model.Cancha?.Tipo)</dd>

                <dt class="col-sm-3 text-info">Fecha:</dt>
                <dd class="col-sm-9">@Model.Fecha.ToShortDateString()</dd>

                <dt class="col-sm-3 text-info">Horario:</dt>
                <dd class="col-sm-9">@Model.HoraInicio.ToString(@"hh\:mm") - @Model.HoraFin.ToString(@"hh\:mm")</dd>

                <dt class="col-sm-3 text-info">Monto:</dt>
                <dd class="col-sm-9 text-success fw-bold">@Model.Monto.ToString("C")</dd>
            </dl>

            <form asp-action="Delete" method="post" class="mt-4">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="IdReserva" />
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger fw-bold">
                        <i class="bi bi-x-circle me-1"></i> Confirmar Cancelación
                    </button>
                    <a asp-action="Index" class="btn btn-outline-light">
                        <i class="bi bi-arrow-left me-1"></i> Volver
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>