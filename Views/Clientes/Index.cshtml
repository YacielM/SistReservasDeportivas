@{
    ViewData["Title"] = "Clientes";
}

<!-- Carga de Bootstrap Icons -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div id="app" class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold text-white mb-0">
            <i class="bi bi-people-fill me-2 text-info"></i>Gestión de Clientes
        </h2>
        <button class="btn btn-success" v-on:click="abrirModalCrear">
            <i class="bi bi-person-plus-fill me-1"></i> Nuevo Cliente
        </button>
    </div>

    <!-- Tabla de Clientes -->
    <div class="card bg-dark text-white shadow border-secondary">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="text-info">DNI</th>
                            <th class="text-info">Nombre</th>
                            <th class="text-info">Apellido</th>
                            <th class="text-info">Email</th>
                            <th class="text-end pe-4 text-info" style="width: 160px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-if="cargando">
                            <td colspan="5" class="text-center py-4 text-muted">
                                <div class="spinner-border spinner-border-sm text-info me-2" role="status"></div>
                                Cargando clientes...
                            </td>
                        </tr>
                        <tr v-else-if="clientes.length === 0">
                            <td colspan="5" class="text-center py-4 text-muted">
                                No hay clientes registrados.
                            </td>
                        </tr>
                        <tr v-for="c in clientes" :key="c.idCliente">
                            <td class="fw-semibold">{{ c.dni }}</td>
                            <td>{{ c.nombre }}</td>
                            <td>{{ c.apellido }}</td>
                            <td>{{ c.email || '-' }}</td>
                            <td class="text-end pe-4">
                                <div class="btn-group btn-group-sm">
                                    <button v-on:click="abrirModalEditar(c)" class="btn btn-warning" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button v-on:click="eliminarCliente(c.idCliente)" class="btn btn-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal para Crear / Editar -->
    <div class="modal fade" id="clienteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title fw-bold">
                        {{ modoEdicion ? 'Editar Cliente' : 'Nuevo Cliente' }}
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <form v-on:submit.prevent="guardarCliente">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">DNI *</label>
                            <input v-model="form.dni" type="text" class="form-control bg-secondary text-white border-0" required placeholder="Ej: 40123456" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre *</label>
                            <input v-model="form.nombre" type="text" class="form-control bg-secondary text-white border-0" required placeholder="Ej: Juan" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Apellido *</label>
                            <input v-model="form.apellido" type="text" class="form-control bg-secondary text-white border-0" required placeholder="Ej: Pérez" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Email</label>
                            <input v-model="form.email" type="email" class="form-control bg-secondary text-white border-0" placeholder="juan@ejemplo.com" />
                        </div>
                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn btn-primary" :disabled="guardando">
                                <span v-if="guardando" class="spinner-border spinner-border-sm me-1"></span>
                                {{ modoEdicion ? 'Actualizar' : 'Guardar' }}
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    clientes: [],
                    cargando: false,
                    guardando: false,
                    modoEdicion: false,
                    form: { idCliente: 0, dni: '', nombre: '', apellido: '', email: '' },
                    bsModal: null
                };
            },
            mounted() {
                this.cargarClientes();
                this.bsModal = new bootstrap.Modal(document.getElementById('clienteModal'));
            },
            methods: {
                async cargarClientes() {
                    this.cargando = true;
                    try {
                        const res = await axios.get('/api/ClientesApi');
                        this.clientes = res.data;
                    } catch (err) {
                        alert('Error al cargar la lista de clientes.');
                    } finally {
                        this.cargando = false;
                    }
                },
                abrirModalCrear() {
                    this.modoEdicion = false;
                    this.form = { idCliente: 0, dni: '', nombre: '', apellido: '', email: '' };
                    this.bsModal.show();
                },
                abrirModalEditar(cliente) {
                    this.modoEdicion = true;
                    this.form = { ...cliente };
                    this.bsModal.show();
                },
                async guardarCliente() {
                    this.guardando = true;
                    try {
                        if (this.modoEdicion) {
                            await axios.put(`/api/ClientesApi/${this.form.idCliente}`, this.form);
                        } else {
                            await axios.post('/api/ClientesApi', this.form);
                        }
                        this.bsModal.hide();
                        await this.cargarClientes();
                    } catch (err) {
                        alert('Ocurrió un error al procesar la solicitud.');
                    } finally {
                        this.guardando = false;
                    }
                },
                async eliminarCliente(id) {
                    if (confirm('¿Seguro que deseas eliminar este cliente?')) {
                        try {
                            await axios.delete(`/api/ClientesApi/${id}`);
                            await this.cargarClientes();
                        } catch (err) {
                            alert('Error al eliminar el cliente.');
                        }
                    }
                }
            }
        }).mount('#app');
    </script>
}