@{
    ViewData["Title"] = "Clientes";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div id="app" class="container my-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="text-white fw-bold mb-0">
                <i class="bi bi-people-fill text-info me-2"></i>Gestión de Clientes
            </h2>
            <p class="text-muted small mb-0">Administra el padrón de clientes y verifica sus estados de cuenta.</p>
        </div>
        <button class="btn btn-success fw-bold" v-on:click="abrirModalNuevo">
            <i class="bi bi-person-plus-fill me-1"></i> Nuevo Cliente
        </button>
    </div>

    <!-- Barra de Búsqueda y Filtro de Ordenamiento -->
    <div class="card bg-dark text-white border-secondary shadow-sm mb-4">
        <div class="card-body p-3">
            <div class="row g-2 align-items-center">
                <!-- Buscador por DNI/Nombre -->
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-secondary text-white border-0"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control bg-secondary text-white border-0" placeholder="Buscar por DNI, Nombre o Apellido..." v-model="filtroTexto">
                    </div>
                </div>

                <!-- Ordenar por Deuda / Estado -->
                <div class="col-md-6">
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-secondary text-info border-0"><i class="bi bi-sort-down"></i></span>
                        <select class="form-select bg-secondary text-white border-0" v-model="criterioOrden">
                            <option value="deudores_primero">Ver Deudores primero (Mayor deuda)</option>
                            <option value="al_dia_primero">Ver Clientes al día primero</option>
                            <option value="nombre_asc">Nombre (A-Z)</option>
                            <option value="dni_asc">DNI (Ascendente)</option>
                        </select>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla principal -->
    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="border-bottom border-secondary text-info">
                        <tr>
                            <th class="ps-3">DNI</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Email</th>
                            <th>Teléfono</th>
                            <th class="text-center">Estado / Deuda</th>
                            <th class="text-center pe-3" style="width: 140px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-if="cargando">
                            <td colspan="7" class="text-center py-4 text-muted">
                                <span class="spinner-border spinner-border-sm me-2 text-info" role="status"></span>
                                Cargando lista de clientes...
                            </td>
                        </tr>
                        <tr v-else-if="clientesFiltrados.length === 0">
                            <td colspan="7" class="text-center py-4 text-muted">No se encontraron clientes que coincidan con la búsqueda.</td>
                        </tr>
                        <tr v-for="c in clientesFiltrados" :key="c.idCliente">
                            <td class="ps-3 fw-semibold text-light">{{ c.dni }}</td>
                            <td>{{ c.nombre }}</td>
                            <td>{{ c.apellido }}</td>
                            <td>{{ c.email || '-' }}</td>
                            <td>{{ c.telefono || '-' }}</td>
                            <td class="text-center">
                                <span v-if="c.saldoDeudor > 0" class="badge bg-danger shadow-sm">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Deuda: ${{ c.saldoDeudor.toLocaleString('es-AR', { minimumFractionDigits: 2 }) }}
                                </span>
                                <span v-else class="badge bg-success shadow-sm">
                                    <i class="bi bi-check-circle-fill me-1"></i>Al día
                                </span>
                            </td>
                            <td class="text-center pe-3">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-warning" v-on:click="abrirModalEditar(c)" title="Editar datos del cliente">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-danger" v-on:click="eliminarCliente(c.idCliente)" title="Eliminar cliente">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Formulario (Nuevo / Editar) -->
    <div class="modal fade" id="modalCliente" tabindex="-1" aria-hidden="true" ref="modalCliente">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title fw-bold text-info">
                        <i :class="modoEdicion ? 'bi bi-pencil-square me-2' : 'bi bi-person-plus-fill me-2'"></i>
                        {{ modoEdicion ? 'Editar Cliente' : 'Nuevo Cliente' }}
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <form v-on:submit.prevent="guardarCliente">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">DNI *</label>
                            <input type="text" class="form-control bg-secondary text-white border-0" v-model="form.dni" placeholder="Ej: 40123456" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">Nombre *</label>
                            <input type="text" class="form-control bg-secondary text-white border-0" v-model="form.nombre" placeholder="Ej: Juan" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">Apellido *</label>
                            <input type="text" class="form-control bg-secondary text-white border-0" v-model="form.apellido" placeholder="Ej: Pérez" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">Fecha de Nacimiento *</label>
                            <input type="date" class="form-control bg-secondary text-white border-0" v-model="form.fechaNacimiento" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">Teléfono</label>
                            <input type="text" class="form-control bg-secondary text-white border-0" v-model="form.telefono" placeholder="Ej: 1122334455">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">Email</label>
                            <input type="email" class="form-control bg-secondary text-white border-0" v-model="form.email" placeholder="ejemplo@correo.com">
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success fw-bold" :disabled="guardando">
                            <span v-if="guardando" class="spinner-border spinner-border-sm me-1"></span>
                            {{ modoEdicion ? 'Guardar Cambios' : 'Crear Cliente' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    clientes: [],
                    cargando: true,
                    guardando: false,
                    modoEdicion: false,
                    modalInstance: null,
                    filtroTexto: '',
                    criterioOrden: 'deudores_primero', // Orden por defecto: Deudores primero
                    form: {
                        idCliente: 0,
                        dni: '',
                        nombre: '',
                        apellido: '',
                        fechaNacimiento: '',
                        telefono: '',
                        email: ''
                    }
                }
            },
            computed: {
                clientesFiltrados() {
                    let lista = [...this.clientes];

                    // 1. Filtrado de texto (DNI, Nombre, Apellido)
                    if (this.filtroTexto.trim() !== '') {
                        const q = this.filtroTexto.toLowerCase().trim();
                        lista = lista.filter(c => 
                            c.dni.toLowerCase().includes(q) ||
                            c.nombre.toLowerCase().includes(q) ||
                            c.apellido.toLowerCase().includes(q) ||
                            (`${c.nombre} ${c.apellido}`).toLowerCase().includes(q)
                        );
                    }

                    // 2. Ordenamiento
                    if (this.criterioOrden === 'deudores_primero') {
                        lista.sort((a, b) => (b.saldoDeudor || 0) - (a.saldoDeudor || 0));
                    } else if (this.criterioOrden === 'al_dia_primero') {
                        lista.sort((a, b) => (a.saldoDeudor || 0) - (b.saldoDeudor || 0));
                    } else if (this.criterioOrden === 'nombre_asc') {
                        lista.sort((a, b) => a.nombre.localeCompare(b.nombre));
                    } else if (this.criterioOrden === 'dni_asc') {
                        lista.sort((a, b) => a.dni.localeCompare(b.dni));
                    }

                    return lista;
                }
            },
            mounted() {
                this.cargarClientes();
                this.modalInstance = new bootstrap.Modal(this.$refs.modalCliente);
            },
            methods: {
                async cargarClientes() {
                    this.cargando = true;
                    try {
                        const res = await axios.get('/api/ClientesApi');
                        this.clientes = res.data;
                    } catch (err) {
                        console.error("Error al cargar clientes:", err);
                    } finally {
                        this.cargando = false;
                    }
                },
                abrirModalNuevo() {
                    this.modoEdicion = false;
                    this.form = { idCliente: 0, dni: '', nombre: '', apellido: '', fechaNacimiento: '', telefono: '', email: '' };
                    this.modalInstance.show();
                },
                abrirModalEditar(cliente) {
                    this.modoEdicion = true;
                    this.form = {
                        idCliente: cliente.idCliente,
                        dni: cliente.dni,
                        nombre: cliente.nombre,
                        apellido: cliente.apellido,
                        fechaNacimiento: cliente.fechaNacimiento ? cliente.fechaNacimiento.split('T')[0] : '',
                        telefono: cliente.telefono || '',
                        email: cliente.email || ''
                    };
                    this.modalInstance.show();
                },
                async guardarCliente() {
                    this.guardando = true;
                    try {
                        if (this.modoEdicion) {
                            await axios.put(`/api/ClientesApi/${this.form.idCliente}`, this.form);
                        } else {
                            await axios.post('/api/ClientesApi', this.form);
                        }
                        this.modalInstance.hide();
                        await this.cargarClientes();
                    } catch (err) {
                        alert("Ocurrió un error al guardar los datos del cliente.");
                        console.error(err);
                    } finally {
                        this.guardando = false;
                    }
                },
                async eliminarCliente(id) {
                    if (!confirm("¿Está seguro de que desea eliminar este cliente?")) return;
                    try {
                        await axios.delete(`/api/ClientesApi/${id}`);
                        await this.cargarClientes();
                    } catch (err) {
                        alert("No se pudo eliminar el cliente. Verifique si posee reservas asociadas.");
                        console.error(err);
                    }
                }
            }
        }).mount('#app');
    </script>
}