@{
    ViewData["Title"] = "Clientes";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div id="app" class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-white fw-bold mb-0">
            <i class="bi bi-people-fill text-info me-2"></i>Gestión de Clientes
        </h2>
        <button class="btn btn-success" v-on:click="abrirModalNuevo">
            <i class="bi bi-person-plus-fill me-1"></i> Nuevo Cliente
        </button>
    </div>

    <!-- Tabla -->
    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-dark table-hover align-middle mb-0">
                    <thead class="border-bottom border-secondary text-info">
                        <tr>
                            <th>DNI</th>
                            <th>Nombre</th>
                            <th>Apellido</th>
                            <th>Email</th>
                            <th class="text-center">Estado / Deuda</th>
                            <th class="text-center" style="width: 160px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-if="cargando">
                            <td colspan="6" class="text-center py-4 text-muted">Cargando clientes...</td>
                        </tr>
                        <tr v-else-if="clientes.length === 0">
                            <td colspan="6" class="text-center py-4 text-muted">No hay clientes registrados.</td>
                        </tr>
                        <tr v-for="c in clientes" :key="c.idCliente">
                            <td class="fw-semibold">{{ c.dni }}</td>
                            <td>{{ c.nombre }}</td>
                            <td>{{ c.apellido }}</td>
                            <td>{{ c.email || '-' }}</td>
                            <td class="text-center">
                                <span v-if="c.saldoDeudor > 0" class="badge bg-danger">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Deuda: ${{ c.saldoDeudor.toLocaleString('es-AR', { minimumFractionDigits: 2 }) }}
                                </span>
                                <span v-else class="badge bg-success">
                                    <i class="bi bi-check-circle-fill me-1"></i>Al día
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-warning" v-on:click="abrirModalEditar(c)" title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-danger" v-on:click="eliminarCliente(c.idCliente)" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal Formulario -->
    <div class="modal fade" id="modalCliente" tabindex="-1" aria-hidden="true" ref="modalCliente">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content bg-dark text-white border-secondary">
                <div class="modal-header border-secondary">
                    <h5 class="modal-title fw-bold">
                        {{ modoEdicion ? 'Editar Cliente' : 'Nuevo Cliente' }}
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form v-on:submit.prevent="guardarCliente">
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">DNI *</label>
                            <input type="text" class="form-control bg-secondary text-white border-0" v-model="form.dni" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">Nombre *</label>
                            <input type="text" class="form-control bg-secondary text-white border-0" v-model="form.nombre" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">Apellido *</label>
                            <input type="text" class="form-control bg-secondary text-white border-0" v-model="form.apellido" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">Fecha Nacimiento *</label>
                            <input type="date" class="form-control bg-secondary text-white border-0" v-model="form.fechaNacimiento" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">Teléfono</label>
                            <input type="text" class="form-control bg-secondary text-white border-0" v-model="form.telefono">
                        </div>
                        <div class="mb-3">
                            <label class="form-label text-info fw-semibold">Email</label>
                            <input type="email" class="form-control bg-secondary text-white border-0" v-model="form.email">
                        </div>
                    </div>
                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-outline-light" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success" :disabled="guardando">
                            <span v-if="guardando" class="spinner-border spinner-border-sm me-1"></span>
                            {{ modoEdicion ? 'Guardar Cambios' : 'Crear Cliente' }}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        const { createApp } = Vue;

        createApp({
            data() {
                return {
                    clientes: [],
                    cargando: true,
                    guardando: false,
                    modoEdicion: false,
                    modalInstance: null,
                    form: {
                        idCliente: 0,
                        dni: '',
                        nombre: '',
                        apellido: '',
                        fechaNacimiento: '',
                        telefono: '',
                        email: ''
                    }
                }
            },
            mounted() {
                this.cargarClientes();
                this.modalInstance = new bootstrap.Modal(this.$refs.modalCliente);
            },
            methods: {
                async cargarClientes() {
                    this.cargando = true;
                    try {
                        const res = await axios.get('/api/ClientesApi');
                        this.clientes = res.data;
                    } catch (err) {
                        console.error("Error cargando clientes:", err);
                    } finally {
                        this.cargando = false;
                    }
                },
                abrirModalNuevo() {
                    this.modoEdicion = false;
                    this.form = { idCliente: 0, dni: '', nombre: '', apellido: '', fechaNacimiento: '', telefono: '', email: '' };
                    this.modalInstance.show();
                },
                abrirModalEditar(cliente) {
                    this.modoEdicion = true;
                    this.form = {
                        idCliente: cliente.idCliente,
                        dni: cliente.dni,
                        nombre: cliente.nombre,
                        apellido: cliente.apellido,
                        fechaNacimiento: cliente.fechaNacimiento ? cliente.fechaNacimiento.split('T')[0] : '',
                        telefono: cliente.telefono,
                        email: cliente.email
                    };
                    this.modalInstance.show();
                },
                async guardarCliente() {
                    this.guardando = true;
                    try {
                        if (this.modoEdicion) {
                            await axios.put(`/api/ClientesApi/${this.form.idCliente}`, this.form);
                        } else {
                            await axios.post('/api/ClientesApi', this.form);
                        }
                        this.modalInstance.hide();
                        await this.cargarClientes();
                    } catch (err) {
                        alert("Error al guardar el cliente.");
                        console.error(err);
                    } finally {
                        this.guardando = false;
                    }
                },
                async eliminarCliente(id) {
                    if (!confirm("¿Está seguro de eliminar este cliente?")) return;
                    try {
                        await axios.delete(`/api/ClientesApi/${id}`);
                        await this.cargarClientes();
                    } catch (err) {
                        alert("Error al eliminar el cliente.");
                        console.error(err);
                    }
                }
            }
        }).mount('#app');
    </script>
}